cabal-version: 3.4
name: nihongo-core
version: 0.1.0.0
synopsis: A terminal-first Japanese learning companion for kanji, vocabulary, reading, and daily study workflows.
description:
  A terminal-first Japanese learning companion for studying kanji, vocabulary, readings, stroke order, and grammar directly from the command line, designed for fast, keyboard-driven workflows and daily practice.

license: BSD-3-Clause
license-file: ../LICENSE
author: Nadeem Bitar
maintainer: nadeem@gmail.com
copyright: (c) 2026 Nadeem Bitar
build-type: Simple
extra-doc-files: ../CHANGELOG.md

common common-options
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-uni-patterns
    -Wincomplete-record-updates
    -Wredundant-constraints
    -fhide-source-paths
    -Wmissing-export-lists
    -Wpartial-fields
    -Wmissing-deriving-strategies

  default-language: GHC2024
  default-extensions:
    DeriveAnyClass
    DuplicateRecordFields
    MultilineStrings
    OverloadedLabels
    OverloadedStrings

library
  import: common-options
  hs-source-dirs: src
  exposed-modules:
    Nihongo.Kanji
    Nihongo.Kanji.KanjiVg
    Nihongo.Kanji.StrokeType
    Nihongo.Prelude

  build-depends:
    aeson ^>=2.2,
    aeson-casing ^>=0.2,
    base >=4.20 && <5,
    containers ^>=0.7,
    directory ^>=1.3,
    filepath ^>=1.4,
    generic-lens,
    lens ^>=5.3,
    text ^>=2.1,
    time ^>=1.12,
