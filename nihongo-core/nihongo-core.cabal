cabal-version: 3.4
name: nihongo-core
version: 0.1.0.0
synopsis: A terminal-first Japanese learning companion for kanji, vocabulary, reading, and daily study workflows.
description:
  A terminal-first Japanese learning companion for studying kanji, vocabulary, readings, stroke order, and grammar directly from the command line, designed for fast, keyboard-driven workflows and daily practice.

license: BSD-3-Clause
author: Nadeem Bitar
maintainer: nadeem@gmail.com
copyright: (c) 2026 Nadeem Bitar
build-type: Simple

common common-options
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-uni-patterns
    -Wincomplete-record-updates
    -Wredundant-constraints
    -fhide-source-paths
    -Wmissing-export-lists
    -Wpartial-fields
    -Wmissing-deriving-strategies

  default-language: GHC2024
  default-extensions:
    DeriveAnyClass
    DuplicateRecordFields
    MultilineStrings
    OverloadedLabels
    OverloadedStrings

library
  import: common-options
  hs-source-dirs: src
  exposed-modules:
    Nihongo.Config.Load
    Nihongo.Config.Types
    Nihongo.Kanji
    Nihongo.Kanji.KanjiVg
    Nihongo.Kanji.StrokeOrder
    Nihongo.Kanji.StrokeType
    Nihongo.Prelude

  build-depends:
    aeson ^>=2.2,
    aeson-casing ^>=0.2,
    base >=4.20 && <5,
    bytestring ^>=0.12,
    containers ^>=0.7,
    directory ^>=1.3,
    filepath ^>=1.4,
    generic-lens,
    kdl-hs ^>=1.0,
    lens ^>=5.3,
    text ^>=2.1,
    time ^>=1.12,
    xml-conduit ^>=1.10,

test-suite nihongo-core-tests
  import: common-options
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  other-modules:
    Test.Nihongo.Config.LoadSpec
    Test.Nihongo.Kanji.StrokeOrderSpec

  build-depends:
    base >=4.20 && <5,
    containers ^>=0.7,
    hspec ^>=2.11,
    nihongo-core,
    text ^>=2.1,
