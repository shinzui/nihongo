packages:
  nihongo-core
  nihongo-cli

-- GHC is provided by the Nix devShell (currently pinned to ghc9122 via
-- flake.nix). Add a `with-compiler:` line here if you want cabal to fail
-- loudly when the version drifts from the flake.
test-show-details: direct
tests: True
-- Parallel module compilation
jobs: $ncpus
