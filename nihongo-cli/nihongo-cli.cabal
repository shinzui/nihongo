cabal-version: 3.4
name: nihongo-cli
version: 0.1.0.0
synopsis: Command-line interface for nihongo
description:
  A terminal-first Japanese learning companion for studying kanji, vocabulary, readings, stroke order, and grammar directly from the command line, designed for fast, keyboard-driven workflows and daily practice.

license: BSD-3-Clause
license-file: ../LICENSE
author: Nadeem Bitar
maintainer: nadeem@gmail.com
copyright: (c) 2026 Nadeem Bitar
build-type: Simple
extra-doc-files: ../CHANGELOG.md

common common-options
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-uni-patterns
    -Wincomplete-record-updates
    -Wredundant-constraints
    -fhide-source-paths
    -Wmissing-export-lists
    -Wpartial-fields
    -Wmissing-deriving-strategies

  default-language: GHC2024
  default-extensions:
    DeriveAnyClass
    DuplicateRecordFields
    MultilineStrings
    OverloadedLabels
    OverloadedStrings

library
  import: common-options
  hs-source-dirs: src
  exposed-modules:
    Nihongo.Cli
    Nihongo.Cli.Commands.KanjiDebug
    Nihongo.Cli.Completions
    Nihongo.Cli.Help
    Nihongo.Cli.Stdin
    Nihongo.Cli.Version
    Nihongo.Cli.Width
    Nihongo.Pretty
    Nihongo.Terminal.Image

  autogen-modules: Paths_nihongo_cli
  other-modules: Paths_nihongo_cli

  build-depends:
    base >=4.20 && <5,
    base64-bytestring ^>=1.2,
    bytestring ^>=0.12,
    file-embed ^>=0.0.16,
    nihongo-core,
    generic-lens,
    githash ^>=0.1,
    lens ^>=5.3,
    optparse-applicative >=0.19,
    process ^>=1.6,
    terminal-size ^>=0.3,
    text ^>=2.1,
    unix ^>=2.8,

executable nihongo
  import: common-options
  main-is: Main.hs
  hs-source-dirs: app
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  build-depends:
    base >=4.20 && <5,
    nihongo-cli,
